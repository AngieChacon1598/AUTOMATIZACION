# Variables de entorno - Sistema de Seguimiento de Egresados
# Copia este archivo como config.env y configura tus valores reales

# =====================================================
# CONFIGURACIÓN DE BASE DE DATOS POSTGRESQL
# =====================================================
DB_TYPE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=seguimiento_egresados
DB_USER=postgres
DB_PASSWORD=npg_ueY7Mml0PzkZ
DB_SSLMODE=disable

# =====================================================
# CONFIGURACIÓN JWT
# =====================================================
JWT_SECRET_KEY=tu_clave_secreta_muy_segura_cambiar_en_produccion
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# =====================================================
# CONFIGURACIÓN DE SEGURIDAD
# =====================================================
